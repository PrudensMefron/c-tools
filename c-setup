# ----------------------------------------------------
# AUXILIARY FUNCTIONS

die() { echo -e "${RED}Error: $*${NC}" >&2; exit 1; }
info() { echo -e "${GREEN}Success: $*${NC}"; }
warn() { echo -e "${YELLOW}Warn: $*${NC}"; }
note() { echo -e "${CYAN}$*${NC}"; }

require_value() {
  local option="$1"
  local value="${2:-}"

  [[ -n "$value" && ! "$value" =~ ^- ]] ||
    die "Option '$option' requires a value."
}

require_command() {
  local command_name="$1"

  command -v "$command_name" >/dev/null 2>&1 ||
    die "Required command not found: $command_name"
}

validate_project_name() {
  [[ "$PROJECT_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "Project name must use only letters, numbers, '.', '_' or '-', and must start with a letter or number."
}

validate_language() {
  case "$LANG_CHOICE" in
    c|cpp|both) ;;
    *) die "Invalid language '$LANG_CHOICE'. Use c, cpp or both." ;;
  esac
}

validate_build_system_name() {
  case "$BUILD_SYSTEM" in
    meson|cmake|xmake|zig|make|none) ;;
    *) die "Invalid build system '$BUILD_SYSTEM'. Use meson, cmake, xmake, zig, make or none." ;;
  esac
}

validate_project_kind_name() {
  case "$PROJECT_KIND" in
    traditional|saucer) ;;
    *) die "Invalid project type '$PROJECT_KIND'. Use traditional or saucer." ;;
  esac
}

validate_saucer_build_system_name() {
  case "$SAUCER_BUILD_SYSTEM" in
    cmake|zig-cmake) ;;
    *) die "Invalid Saucer build system '$SAUCER_BUILD_SYSTEM'. Use cmake or zig-cmake." ;;
  esac
}

validate_frontend_runtime_name() {
  case "$FRONTEND_RUNTIME" in
    bun|pnpm|npm|yarn) ;;
    *) die "Invalid frontend runtime '$FRONTEND_RUNTIME'. Use bun, pnpm, npm or yarn." ;;
  esac
}

validate_c_standard() {
  case "$C_STANDARD" in
    c89|c99|c11|c17|c23) ;;
    *) die "Invalid C standard '$C_STANDARD'. Use c89, c99, c11, c17 or c23." ;;
  esac
}

validate_cpp_standard() {
  case "$CPP_STANDARD" in
    c++11|c++14|c++17|c++20|c++23) ;;
    *) die "Invalid C++ standard '$CPP_STANDARD'. Use c++11, c++14, c++17, c++20 or c++23." ;;
  esac
}

version_ge() {
  local current="$1"
  local minimum="$2"

  [[ "$(printf '%s\n%s\n' "$minimum" "$current" | sort -V | head -n1)" == "$minimum" ]]
}

validate_zig_version() {
  local version
  version="$(zig version)"

  case "$version" in
    0.16.*) ;;
    *)
      die "The generated build.zig targets Zig 0.16.x, but the installed version is '$version'."
      ;;
  esac
}

validate_cmake_version() {
  local minimum="$1"
  local version

  version="$(cmake --version | head -n1 | awk '{print $3}')"

  if [[ -z "$version" || ! "$version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    warn "Could not determine the installed CMake version. The generated project requires CMake >= $minimum."
    return
  fi

  version_ge "$version" "$minimum" ||
    die "The generated project requires CMake >= $minimum, but '$version' is installed."
}

validate_xmake_version() {
  local version
  version="$(xmake --version 2>/dev/null | head -n1 | sed -E 's/.*v([0-9]+\.[0-9]+\.[0-9]+).*/\1/')"

  if [[ -z "$version" || ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    warn "Could not determine the installed Xmake version. The generated file requires Xmake >= 2.8.3."
    return
  fi

  version_ge "$version" "2.8.3" ||
    die "The generated xmake.lua requires Xmake >= 2.8.3, but '$version' is installed."
}

resolve_requested_standard() {
  [[ -z "$REQUESTED_STD" ]] && return

  case "$LANG_CHOICE" in
    c)
      C_STANDARD="$REQUESTED_STD"
      ;;
    cpp)
      CPP_STANDARD="$REQUESTED_STD"
      ;;
    both)
      die "--std is ambiguous with --language both. Use --c-std and --cpp-std."
      ;;
  esac
}

get_author_info() {
  local git_name=""
  local git_email=""

  command -v git >/dev/null 2>&1 || return 0

  git_name=$(git config --local --get user.name 2>/dev/null || true)
  git_email=$(git config --local --get user.email 2>/dev/null || true)

  [[ -z "$git_name" ]] && git_name=$(git config --global --get user.name 2>/dev/null || true)
  [[ -z "$git_email" ]] && git_email=$(git config --global --get user.email 2>/dev/null || true)

  [[ -z "$AUTHOR_NAME" ]] && AUTHOR_NAME="${git_name:-}"
  [[ -z "$AUTHOR_EMAIL" ]] && AUTHOR_EMAIL="${git_email:-}"
}

runtime_build_command() {
  case "$FRONTEND_RUNTIME" in
    bun) echo "bun run build" ;;
    pnpm) echo "pnpm run build" ;;
    npm) echo "npm run build" ;;
    yarn) echo "yarn run build" ;;
    *) die "Unknown frontend runtime: $FRONTEND_RUNTIME" ;;
  esac
}

runtime_install_command() {
  case "$FRONTEND_RUNTIME" in
    bun) echo "bun install" ;;
    pnpm) echo "pnpm install" ;;
    npm) echo "npm install" ;;
    yarn) echo "yarn install" ;;
    *) die "Unknown frontend runtime: $FRONTEND_RUNTIME" ;;
  esac
}

runtime_vite_command() {
  case "$FRONTEND_RUNTIME" in
    bun) echo "bun create vite ." ;;
    pnpm) echo "pnpm create vite ." ;;
    npm) echo "npm create vite@latest ." ;;
    yarn) echo "yarn create vite ." ;;
    *) die "Unknown frontend runtime: $FRONTEND_RUNTIME" ;;
  esac
}

cmake_c_standard_value() {
  case "$C_STANDARD" in
    c89) echo "90" ;;
    *) echo "${C_STANDARD#c}" ;;
  esac
}

cmake_minimum_version() {
  local minor=16

  if [[ "$LANG_CHOICE" == "c" || "$LANG_CHOICE" == "both" ]]; then
    case "$C_STANDARD" in
      c17|c23) minor=21 ;;
    esac
  fi

  if [[ "$LANG_CHOICE" == "cpp" || "$LANG_CHOICE" == "both" ]]; then
    if [[ "$CPP_STANDARD" == "c++23" && "$minor" -lt 20 ]]; then
      minor=20
    fi
  fi

  echo "3.$minor"
}

author_line() {
  if [[ -n "$AUTHOR_NAME" && -n "$AUTHOR_EMAIL" ]]; then
    printf 'Created by %s <%s>\n' "$AUTHOR_NAME" "$AUTHOR_EMAIL"
  elif [[ -n "$AUTHOR_NAME" ]]; then
    printf 'Created by %s\n' "$AUTHOR_NAME"
  fi
}

# ----------------------------------------------------
# INTERACTIVE QUESTIONS

ask_project_kind() {
  [[ -n "$PROJECT_KIND" ]] && return

  echo -e "\nChoose project type:"
  select opt in "Traditional C/C++" "Desktop WebView with Saucer"; do
    case $REPLY in
      1)
        PROJECT_KIND="traditional"
        break
        ;;
      2)
        PROJECT_KIND="saucer"
        LANG_CHOICE="cpp"
        CPP_STANDARD="c++23"
        break
        ;;
      *)
        warn "Invalid option."
        ;;
    esac
  done
}

ask_language() {
  [[ -n "$LANG_CHOICE" ]] && return

  echo -e "\nChoose language:"
  select opt in "C" "C++" "Both (C & C++)"; do
    case $REPLY in
      1) LANG_CHOICE="c"; break ;;
      2) LANG_CHOICE="cpp"; break ;;
      3) LANG_CHOICE="both"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_build_system() {
  [[ -n "$BUILD_SYSTEM" ]] && return

  echo -e "\nChoose a build system:"
  select build in \
    "Meson + Ninja (default)" \
    "CMake + Ninja" \
    "Xmake" \
    "Zig" \
    "Makefile" \
    "None"; do

    case $REPLY in
      1) BUILD_SYSTEM="meson"; break ;;
      2) BUILD_SYSTEM="cmake"; break ;;
      3) BUILD_SYSTEM="xmake"; break ;;
      4) BUILD_SYSTEM="zig"; break ;;
      5) BUILD_SYSTEM="make"; break ;;
      6) BUILD_SYSTEM="none"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_saucer_build_system() {
  [[ -n "$SAUCER_BUILD_SYSTEM" ]] && return

  echo -e "\nChoose the Saucer build system:"
  select build in "CMake + Ninja" "Zig + CMake + Ninja"; do
    case $REPLY in
      1) SAUCER_BUILD_SYSTEM="cmake"; break ;;
      2) SAUCER_BUILD_SYSTEM="zig-cmake"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_frontend_runtime() {
  [[ -n "$FRONTEND_RUNTIME" ]] && return

  echo -e "\nChoose the frontend package manager/runtime:"
  select runtime in "Bun" "Pnpm" "Npm" "Yarn"; do
    case $REPLY in
      1) FRONTEND_RUNTIME="bun"; break ;;
      2) FRONTEND_RUNTIME="pnpm"; break ;;
      3) FRONTEND_RUNTIME="npm"; break ;;
      4) FRONTEND_RUNTIME="yarn"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_git() {
  read -rp $'\nInitialize a blank Git repository? [Y/n] ' ans
  if [[ "$ans" =~ ^([yY]|[yY][eE][sS]|)$ ]]; then
    USE_GIT=true
  fi
}

ask_format() {
  read -rp $'\nAdd Allman++ .clang-format? [Y/n] ' ans
  if [[ "$ans" =~ ^([yY]|[yY][eE][sS]|)$ ]]; then
    USE_CLANG_FORMAT=true
    USE_ZED_SETTINGS=true
  fi

  read -rp $'\nAdd .clang-tidy? [Y/n] ' ans
  if [[ "$ans" =~ ^([yY]|[yY][eE][sS]|)$ ]]; then
    USE_CLANG_TIDY=true
  fi
}

ask_standards() {
  if [[ "$LANG_CHOICE" == "c" || "$LANG_CHOICE" == "both" ]]; then
    echo -e "\nSelect C standard:"
    select std in "c89" "c99" "c11" "c17" "c23"; do
      case $REPLY in
        1|2|3|4|5)
          C_STANDARD="$std"
          break
          ;;
        *)
          warn "Invalid option."
          ;;
      esac
    done
  fi

  if [[ "$LANG_CHOICE" == "cpp" || "$LANG_CHOICE" == "both" ]]; then
    echo -e "\nSelect C++ standard:"
    select std in "c++11" "c++14" "c++17" "c++20" "c++23"; do
      case $REPLY in
        1|2|3|4|5)
          CPP_STANDARD="$std"
          break
          ;;
        *)
          warn "Invalid option."
          ;;
      esac
    done
  fi
}

ask_author() {
  get_author_info

  if [[ -n "$AUTHOR_NAME" ]]; then
    if [[ -n "$AUTHOR_EMAIL" ]]; then
      info "Author detected: $AUTHOR_NAME <$AUTHOR_EMAIL>"
    else
      info "Author detected: $AUTHOR_NAME"
    fi

    read -rp $'Use this author info? [Y/n] ' ans
    if [[ ! "$ans" =~ ^([yY]|[yY][eE][sS]|)$ ]]; then
      read -rp $'New author name: ' AUTHOR_NAME
      read -rp $'New author email: ' AUTHOR_EMAIL
    fi
  else
    warn "Author info not detected."
    read -rp $'Your name: ' AUTHOR_NAME
    read -rp $'Your email: ' AUTHOR_EMAIL
  fi
}

confirm_plan() {
  $AUTO_CONFIRM && return 0
  ! $INTERACTIVE && return 0

  read -rp $'\nCreate project with these settings? [Y/n] ' ans
  [[ "$ans" =~ ^([yY]|[yY][eE][sS]|)$ ]] ||
    die "Operation cancelled."
}

