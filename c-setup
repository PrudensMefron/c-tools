# PLAN / DEFAULT RESOLUTION

resolve_full_configuration() {
  if $INTERACTIVE; then
    ask_project_kind

    if [[ "$PROJECT_KIND" == "saucer" ]]; then
      LANG_CHOICE="cpp"
      CPP_STANDARD="c++23"
      ask_saucer_build_system
      ask_frontend_runtime
      ask_git
      ask_format
      ask_author
    else
      ask_language
      ask_build_system
      ask_git
      ask_format
      ask_standards
      ask_author
    fi
  else
    PROJECT_KIND="${PROJECT_KIND:-traditional}"

    if [[ "$PROJECT_KIND" == "saucer" ]]; then
      LANG_CHOICE="cpp"
      CPP_STANDARD="c++23"
      SAUCER_BUILD_SYSTEM="${SAUCER_BUILD_SYSTEM:-cmake}"
      FRONTEND_RUNTIME="${FRONTEND_RUNTIME:-bun}"
    else
      LANG_CHOICE="${LANG_CHOICE:-cpp}"
      BUILD_SYSTEM="${BUILD_SYSTEM:-meson}"
      resolve_requested_standard
    fi

    get_author_info
  fi

  validate_project_kind_name

  if [[ "$PROJECT_KIND" == "saucer" ]]; then
    validate_saucer_build_system_name
    validate_frontend_runtime_name
  else
    validate_language
    validate_build_system_name
    validate_c_standard
    validate_cpp_standard
  fi
}

resolve_build_configuration() {
  if $INTERACTIVE; then
    ask_language
    ask_build_system
    ask_standards
  else
    LANG_CHOICE="${LANG_CHOICE:-cpp}"
    BUILD_SYSTEM="${BUILD_SYSTEM:-meson}"
    resolve_requested_standard
  fi

  validate_language
  validate_build_system_name
  validate_c_standard
  validate_cpp_standard
}

resolve_lang_configuration() {
  if $INTERACTIVE; then
    ask_language
  else
    LANG_CHOICE="${LANG_CHOICE:-cpp}"
  fi

  validate_language
}

resolve_format_configuration() {
  if $INTERACTIVE; then
    ask_format
  fi
}

print_plan() {
  echo
  note "Resolved project plan:"
  printf '  Project: %s\n' "$PROJECT_NAME"
  printf '  Location: %s\n' "$PROJECT_DIR"
  printf '  Operation: %s\n' "$MODE"

  case "$MODE" in
    full)
      printf '  Type: %s\n' "$PROJECT_KIND"

      if [[ "$PROJECT_KIND" == "saucer" ]]; then
        printf '  Language: C++\n'
        printf '  C++ standard: c++23\n'
        printf '  Saucer build: %s\n' "$SAUCER_BUILD_SYSTEM"
        printf '  Frontend runtime: %s\n' "$FRONTEND_RUNTIME"
      else
        printf '  Language: %s\n' "$LANG_CHOICE"
        printf '  Build system: %s\n' "$BUILD_SYSTEM"
        [[ "$LANG_CHOICE" == "c" || "$LANG_CHOICE" == "both" ]] &&
          printf '  C standard: %s\n' "$C_STANDARD"
        [[ "$LANG_CHOICE" == "cpp" || "$LANG_CHOICE" == "both" ]] &&
          printf '  C++ standard: %s\n' "$CPP_STANDARD"
      fi

      printf '  Git: %s\n' "$USE_GIT"
      printf '  clang-format: %s\n' "$USE_CLANG_FORMAT"
      printf '  clang-tidy: %s\n' "$USE_CLANG_TIDY"
      printf '  Zed settings: %s\n' "$USE_ZED_SETTINGS"
      ;;

    build)
      printf '  Language: %s\n' "$LANG_CHOICE"
      printf '  Build system: %s\n' "$BUILD_SYSTEM"
      [[ "$LANG_CHOICE" == "c" || "$LANG_CHOICE" == "both" ]] &&
        printf '  C standard: %s\n' "$C_STANDARD"
      [[ "$LANG_CHOICE" == "cpp" || "$LANG_CHOICE" == "both" ]] &&
        printf '  C++ standard: %s\n' "$CPP_STANDARD"
      ;;

    lang)
      printf '  Language: %s\n' "$LANG_CHOICE"
      ;;

    git)
      printf '  Git repository: initialize\n'
      ;;

    format)
      printf '  clang-format: %s\n' "$USE_CLANG_FORMAT"
      printf '  clang-tidy: %s\n' "$USE_CLANG_TIDY"
      printf '  Zed settings: %s\n' "$USE_ZED_SETTINGS"
      ;;
  esac
}

