# SAUCER PROJECT CREATION

create_saucer_structure() {
  info "Creating Saucer desktop WebView structure in $PROJECT_DIR"

  mkdir -p "$PROJECT_DIR"/{src,include,frontend/tools,docs,external}

  cat > "$PROJECT_DIR/.gitignore" <<'EOF'
build/
compile_commands.json

frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/

.vscode/
.idea/

*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
EOF

  if ! $USE_ZED_SETTINGS; then
    cat >> "$PROJECT_DIR/.gitignore" <<'EOF'
.zed/
EOF
  fi

  if [[ "$SAUCER_BUILD_SYSTEM" == "zig-cmake" ]]; then
    cat >> "$PROJECT_DIR/.gitignore" <<'EOF'
zig-out/
.zig-cache/
EOF
  fi
}

create_saucer_main() {
  local content="$SAUCER_MAIN_CPP"
  local app_id="${PROJECT_NAME//_/-}"

  content="${content//\{PROJECT_NAME\}/$PROJECT_NAME}"
  content="${content//\{APP_ID\}/$app_id}"

  printf '%s\n' "$content" > "$PROJECT_DIR/src/main.cpp"
}

create_saucer_cmake_native() {
  info "Generating Saucer CMake + Ninja configuration"

  local content="${SAUCER_CMAKE_NATIVE//\{PROJECT_NAME\}/$PROJECT_NAME}"

  printf '%s\n' "$content" > "$PROJECT_DIR/CMakeLists.txt"
  printf '%s\n' "$SAUCER_CLANGD_NATIVE" > "$PROJECT_DIR/.clangd"
}

create_saucer_cmake_zig() {
  info "Generating Saucer Zig + CMake + Ninja configuration"

  local content="${SAUCER_CMAKE_ZIG//\{PROJECT_NAME\}/$PROJECT_NAME}"

  printf '%s\n' "$content" > "$PROJECT_DIR/CMakeLists.txt"
  printf '%s\n' "$SAUCER_CLANGD_ZIG" > "$PROJECT_DIR/.clangd"

  create_saucer_zig_build
}

create_saucer_dev_script() {
  info "Generating frontend/tools/dev.mjs for $FRONTEND_RUNTIME"

  if [[ "$FRONTEND_RUNTIME" == "bun" ]]; then
    printf '%s\n' "$DEV_MJS_BUN" > "$PROJECT_DIR/frontend/tools/dev.mjs"
  else
    printf '%s\n' "$DEV_MJS_NODE" > "$PROJECT_DIR/frontend/tools/dev.mjs"
  fi

  chmod +x "$PROJECT_DIR/frontend/tools/dev.mjs"
}

create_saucer_zig_build() {
  local frontend_build
  local runtime_exec

  case "$FRONTEND_RUNTIME" in
    bun)
      frontend_build='"bun", "run", "build"'
      runtime_exec='"bun", "frontend/tools/dev.mjs"'
      ;;
    pnpm)
      frontend_build='"pnpm", "run", "build"'
      runtime_exec='"node", "frontend/tools/dev.mjs"'
      ;;
    npm)
      frontend_build='"npm", "run", "build"'
      runtime_exec='"node", "frontend/tools/dev.mjs"'
      ;;
    yarn)
      frontend_build='"yarn", "run", "build"'
      runtime_exec='"node", "frontend/tools/dev.mjs"'
      ;;
    *)
      die "Unknown frontend runtime: $FRONTEND_RUNTIME"
      ;;
  esac

  cat > "$PROJECT_DIR/build.zig" <<EOF
const std = @import("std");

const project_name = "$PROJECT_NAME";

pub fn build(b: *std.Build) void {
    const frontend_build = b.addSystemCommand(&.{
        "cmake",
        "-E",
        "chdir",
        "frontend",
        $frontend_build,
    });

    const debug_configure = addConfigure(
        b,
        "zig-out/debug/cmake",
        "Debug",
        false,
    );
    debug_configure.step.dependOn(&frontend_build.step);

    const debug_db = addCompileDatabaseSync(b, debug_configure, "zig-out/debug/cmake");
    const debug_compile = addCompile(b, debug_db, "zig-out/debug/cmake");

    b.getInstallStep().dependOn(&debug_compile.step);

    const build_step = b.step("build", "Build frontend and debug embedded application");
    build_step.dependOn(&debug_compile.step);

    const dev_configure = addConfigure(
        b,
        "zig-out/dev/cmake",
        "Debug",
        true,
    );

    const dev_db = addCompileDatabaseSync(b, dev_configure, "zig-out/dev/cmake");
    const dev_compile = addCompile(b, dev_db, "zig-out/dev/cmake");

    const dev_run = b.addSystemCommand(&.{
        $runtime_exec,
        "zig-out/dev/bin/$PROJECT_NAME",
    });
    dev_run.step.dependOn(&dev_compile.step);

    const dev_step = b.step("dev", "Run Vite dev server and debug native application");
    dev_step.dependOn(&dev_run.step);

    const run = b.addSystemCommand(&.{ "zig-out/debug/bin/$PROJECT_NAME" });
    run.step.dependOn(&debug_compile.step);

    if (b.args) |args| run.addArgs(args);

    const run_step = b.step("run", "Build and run the debug embedded application");
    run_step.dependOn(&run.step);

    const release_frontend_build = b.addSystemCommand(&.{
        "cmake",
        "-E",
        "chdir",
        "frontend",
        $frontend_build,
    });

    const release_configure = addConfigure(
        b,
        "zig-out/release/cmake",
        "Release",
        false,
    );
    release_configure.step.dependOn(&release_frontend_build.step);

    const release_compile = addCompile(b, release_configure, "zig-out/release/cmake");

    const release_step = b.step("release", "Build optimized embedded release application");
    release_step.dependOn(&release_compile.step);

    const release_run = b.addSystemCommand(&.{ "zig-out/release/bin/$PROJECT_NAME" });
    release_run.step.dependOn(&release_compile.step);

    if (b.args) |args| release_run.addArgs(args);

    const release_run_step = b.step("release-run", "Build and run optimized release application");
    release_run_step.dependOn(&release_run.step);

    const release_clean = b.addSystemCommand(&.{
        "rm",
        "-rf",
        "zig-out/release",
    });

    const release_clean_step = b.step("release-clean", "Remove only release build artifacts");
    release_clean_step.dependOn(&release_clean.step);

    const clean = b.addSystemCommand(&.{
        "rm",
        "-rf",
        "zig-out",
        "frontend/dist",
        "compile_commands.json",
    });

    const clean_step = b.step("clean", "Remove dev, debug, release and frontend dist artifacts");
    clean_step.dependOn(&clean.step);

    const clean_all = b.addSystemCommand(&.{
        "rm",
        "-rf",
        "zig-out",
        ".zig-cache",
        "compile_commands.json",
        "frontend/dist",
        "frontend/node_modules",
        "frontend/.vite",
        "frontend/.cache",
    });

    const clean_all_step = b.step("clean-all", "Remove every reconstructible local build artifact");
    clean_all_step.dependOn(&clean_all.step);
}

fn addConfigure(
    b: *std.Build,
    build_dir: []const u8,
    build_type: []const u8,
    dev_frontend: bool,
) *std.Build.Step.Run {
    const configure = b.addSystemCommand(&.{
        "cmake",
        "-E",
        "env",
        "CXX=zig c++",
        "cmake",
        "-S",
        ".",
        "-B",
        build_dir,
        "-G",
        "Ninja",
    });

    configure.addArg(b.fmt("-DCMAKE_BUILD_TYPE={s}", .{build_type}));
    configure.addArg(if (dev_frontend) "-DAPP_DEV_FRONTEND=ON" else "-DAPP_DEV_FRONTEND=OFF");
    configure.addArg("-DCMAKE_EXPORT_COMPILE_COMMANDS=ON");

    return configure;
}

fn addCompile(
    b: *std.Build,
    dependency: *std.Build.Step.Run,
    build_dir: []const u8,
) *std.Build.Step.Run {
    const compile = b.addSystemCommand(&.{
        "cmake",
        "--build",
        build_dir,
        "--target",
        project_name,
        "--parallel",
    });

    compile.step.dependOn(&dependency.step);
    return compile;
}

fn addCompileDatabaseSync(
    b: *std.Build,
    configure: *std.Build.Step.Run,
    build_dir: []const u8,
) *std.Build.Step.Run {
    const source = b.fmt("{s}/compile_commands.json", .{build_dir});
    const sync = b.addSystemCommand(&.{
        "cmake",
        "-E",
        "copy_if_different",
        source,
        "compile_commands.json",
    });

    sync.step.dependOn(&configure.step);
    return sync;
}
EOF
}

create_saucer_readme() {
  local build_cmd
  local install_cmd
  local vite_cmd

  build_cmd=$(runtime_build_command)
  install_cmd=$(runtime_install_command)
  vite_cmd=$(runtime_vite_command)

  {
    printf '# %s\n\n' "$PROJECT_NAME"
    printf 'Saucer desktop WebView application with a Vite frontend.\n'

    local byline
    byline="$(author_line)"
    if [[ -n "$byline" ]]; then
      printf '\n%s\n' "$byline"
    fi
  } > "$PROJECT_DIR/README.md"

  cat >> "$PROJECT_DIR/README.md" <<EOF

## Frontend initialization

The setup intentionally does not choose a Vite framework for you. Create the
Vite project inside \`frontend/\` with $FRONTEND_RUNTIME:

\`\`\`bash
cd frontend
$vite_cmd
$install_cmd
\`\`\`

The \`frontend/tools/dev.mjs\` file is generated by c-setup. Because \`frontend/\`
is already non-empty, create-vite may warn about the existing \`tools/\` folder.
Choose the option that keeps/ignores existing files rather than deleting them.

The production frontend command used by this project is:

\`\`\`bash
$build_cmd
\`\`\`
EOF

  if [[ "$SAUCER_BUILD_SYSTEM" == "zig-cmake" ]]; then
    cat >> "$PROJECT_DIR/README.md" <<'EOF'

## Build commands

```bash
zig build
zig build dev
zig build run
zig build release
zig build release-run
zig build release-clean
zig build clean
zig build clean-all
```
EOF
  else
    cat >> "$PROJECT_DIR/README.md" <<EOF

## CMake + Ninja

Development native build:

\`\`\`bash
cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DAPP_DEV_FRONTEND=ON
cmake --build build --parallel
EOF

    if [[ "$FRONTEND_RUNTIME" == "bun" ]]; then
      cat >> "$PROJECT_DIR/README.md" <<EOF
bun frontend/tools/dev.mjs build/$PROJECT_NAME
\`\`\`
EOF
    else
      cat >> "$PROJECT_DIR/README.md" <<EOF
node frontend/tools/dev.mjs build/$PROJECT_NAME
\`\`\`
EOF
    fi

    cat >> "$PROJECT_DIR/README.md" <<EOF

Embedded build:

\`\`\`bash
cd frontend
$build_cmd
cd ..
cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DAPP_DEV_FRONTEND=OFF
cmake --build build --parallel
\`\`\`
EOF
  fi
}

print_saucer_next_steps() {
  local vite_cmd
  local install_cmd

  vite_cmd=$(runtime_vite_command)
  install_cmd=$(runtime_install_command)

  echo
  note "Next: create your Vite project inside frontend/ using $FRONTEND_RUNTIME."
  echo "  cd \"$PROJECT_DIR/frontend\""
  echo "  $vite_cmd"
  echo "  $install_cmd"

  warn "frontend/tools/dev.mjs already exists. If create-vite warns that the directory is not empty, keep/ignore existing files; do not delete tools/."

  if [[ "$SAUCER_BUILD_SYSTEM" == "zig-cmake" ]]; then
    echo
    note "Then use:"
    echo "  zig build dev"
    echo "  zig build"
    echo "  zig build run"
    echo "  zig build release"
    echo "  zig build release-run"
    echo "  zig build release-clean"
    echo "  zig build clean"
    echo "  zig build clean-all"
  fi
}

# ----------------------------------------------------
# GIT

git_init() {
  if $USE_GIT; then
    info "Initializing Git repository in $PROJECT_DIR"
    mkdir -p "$PROJECT_DIR"
    (cd "$PROJECT_DIR" && git init)
  fi
}

# ----------------------------------------------------
# EXECUTION

execute_traditional_full() {
  create_traditional_structure
  create_build_system

  $USE_CLANG_FORMAT && create_clang_format
  $USE_ZED_SETTINGS && create_zed_settings
  $USE_CLANG_TIDY && create_clang_tidy

  create_main
  git_init
}

execute_saucer_full() {
  create_saucer_structure
  create_saucer_main
  create_saucer_dev_script

  if [[ "$SAUCER_BUILD_SYSTEM" == "cmake" ]]; then
    create_saucer_cmake_native
  else
    create_saucer_cmake_zig
  fi

  $USE_CLANG_FORMAT && create_clang_format
  $USE_ZED_SETTINGS && create_zed_settings
  $USE_CLANG_TIDY && create_clang_tidy

  create_saucer_readme
  git_init
  print_saucer_next_steps
}

execute_full() {
  if [[ "$PROJECT_KIND" == "saucer" ]]; then
    execute_saucer_full
  else
    execute_traditional_full
  fi
}

execute_build() {
  mkdir -p "$PROJECT_DIR"/{src,include}
  create_build_system
}

execute_lang() {
  mkdir -p "$PROJECT_DIR/src"
  create_main
}

execute_format() {
  mkdir -p "$PROJECT_DIR"

  $USE_CLANG_FORMAT && create_clang_format
  $USE_ZED_SETTINGS && create_zed_settings
  $USE_CLANG_TIDY && create_clang_tidy
}

execute_git() {
  USE_GIT=true
  git_init
}

# ----------------------------------------------------
# MAIN

main() {
  parse_args "$@"

  echo -e "${GREEN}=== Allman++ C/C++ Project Setup ===${NC}"

  case "$MODE" in
    full) resolve_full_configuration ;;
    build) resolve_build_configuration ;;
    lang) resolve_lang_configuration ;;
    format) resolve_format_configuration ;;
    git) ;;
    *) die "Unknown operation mode: $MODE" ;;
  esac

  print_plan
  validate_environment

  if $DRY_RUN; then
    note "Dry run: no files were written."
    exit 0
  fi

  if [[ "$MODE" == "full" ]]; then
    confirm_plan
  fi

  case "$MODE" in
    full) execute_full ;;
    build) execute_build ;;
    lang) execute_lang ;;
    format) execute_format ;;
    git) execute_git ;;
  esac

  info "Project operation completed successfully."
  echo "Location: $PROJECT_DIR"
}

main "$@"
