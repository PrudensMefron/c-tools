usage() {
  cat <<'EOF'
Usage: c-setup [options] [project_name]

Operation modes:
  -b, --build                 Setup only a traditional build system
  -l, --lang [c|cpp|both]     Setup only the language and main source file
      --lang-only [lang]      Same as --lang
  -g, --git                   Initialize a Git repository only
  -f, --format                Setup clang-format, Zed settings and clang-tidy only
  -h, --help                  Show this help message

Full/project configuration:
      --type TYPE              traditional | saucer
      --language LANG          c | cpp | both
      --build-system SYSTEM    meson | cmake | xmake | zig | make | none
      --std STANDARD           Standard for the selected single language
      --c-std STANDARD         c89 | c99 | c11 | c17 | c23
      --cpp-std STANDARD       c++11 | c++14 | c++17 | c++20 | c++23

Saucer:
      --saucer-build SYSTEM    cmake | zig-cmake
      --runtime RUNTIME        bun | pnpm | npm | yarn

Optional project files:
      --init-git               Initialize Git in a full setup
      --no-init-git            Do not initialize Git
      --clang-format           Generate Allman++ .clang-format
      --no-clang-format        Do not generate .clang-format
      --clang-tidy             Generate .clang-tidy
      --no-clang-tidy          Do not generate .clang-tidy
      --zed-settings           Generate .zed/settings.json
      --no-zed-settings        Do not generate Zed project settings

Metadata and execution:
      --author-name NAME       Set README author name
      --author-email EMAIL     Set README author email
      --non-interactive        Do not ask questions; use supplied values/defaults
  -y, --yes                    Skip the final confirmation
      --dry-run                Show the resolved plan without writing files

Non-interactive full setup defaults:
  type=traditional, language=cpp, build-system=meson,
  C standard=c11, C++ standard=c++17.

Examples:
  c-setup hello

  c-setup hello \
    --non-interactive \
    --type traditional \
    --language cpp \
    --std c++23 \
    --build-system xmake \
    --init-git \
    --clang-format \
    --clang-tidy \
    --zed-settings

  c-setup --build --language cpp --cpp-std c++23 --build-system xmake
EOF
  exit 0
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--build)
        MODE="build"
        shift
        ;;

      -l|--lang|--lang-only)
        MODE="lang"
        if [[ -n "${2:-}" && ! "$2" =~ ^- ]]; then
          LANG_CHOICE="$2"
          shift 2
        else
          shift
        fi
        ;;

      -g|--git)
        MODE="git"
        shift
        ;;

      -f|--format)
        MODE="format"
        shift
        ;;

      --type)
        require_value "$1" "${2:-}"
        PROJECT_KIND="$2"
        shift 2
        ;;

      --language)
        require_value "$1" "${2:-}"
        LANG_CHOICE="$2"
        shift 2
        ;;

      --build-system)
        require_value "$1" "${2:-}"
        BUILD_SYSTEM="$2"
        shift 2
        ;;

      --std)
        require_value "$1" "${2:-}"
        REQUESTED_STD="$2"
        shift 2
        ;;

      --c-std)
        require_value "$1" "${2:-}"
        C_STANDARD="$2"
        shift 2
        ;;

      --cpp-std)
        require_value "$1" "${2:-}"
        CPP_STANDARD="$2"
        shift 2
        ;;

      --saucer-build)
        require_value "$1" "${2:-}"
        SAUCER_BUILD_SYSTEM="$2"
        shift 2
        ;;

      --runtime)
        require_value "$1" "${2:-}"
        FRONTEND_RUNTIME="$2"
        shift 2
        ;;

      --init-git)
        USE_GIT=true
        shift
        ;;

      --no-init-git)
        USE_GIT=false
        shift
        ;;

      --clang-format)
        USE_CLANG_FORMAT=true
        shift
        ;;

      --no-clang-format)
        USE_CLANG_FORMAT=false
        shift
        ;;

      --clang-tidy)
        USE_CLANG_TIDY=true
        shift
        ;;

      --no-clang-tidy)
        USE_CLANG_TIDY=false
        shift
        ;;

      --zed-settings)
        USE_ZED_SETTINGS=true
        shift
        ;;

      --no-zed-settings)
        USE_ZED_SETTINGS=false
        shift
        ;;

      --author-name)
        require_value "$1" "${2:-}"
        AUTHOR_NAME="$2"
        shift 2
        ;;

      --author-email)
        require_value "$1" "${2:-}"
        AUTHOR_EMAIL="$2"
        shift 2
        ;;

      --non-interactive)
        INTERACTIVE=false
        shift
        ;;

      -y|--yes)
        AUTO_CONFIRM=true
        shift
        ;;

      --dry-run)
        DRY_RUN=true
        shift
        ;;

      -h|--help)
        usage
        ;;

      -*)
        die "Unknown option: $1. Use -h for help."
        ;;

      *)
        if [[ -z "$PROJECT_NAME" ]]; then
          PROJECT_NAME="$1"
          shift
        else
          die "Multiple project names provided: $PROJECT_NAME and $1"
        fi
        ;;
    esac
  done

  if [[ -z "$PROJECT_NAME" ]]; then
    if [[ "$MODE" == "full" ]]; then
      if $INTERACTIVE; then
        read -rp "Project name: " PROJECT_NAME
        [[ -n "$PROJECT_NAME" ]] || die "Project name is required."
      else
        die "Project name is required in non-interactive full setup."
      fi
    else
      PROJECT_NAME=$(basename "$(pwd)")
    fi
  fi

  validate_project_name

  if [[ "$PROJECT_NAME" == "$(basename "$(pwd)")" ]]; then
    PROJECT_DIR="$(pwd)"
  else
    PROJECT_DIR="$(pwd)/$PROJECT_NAME"

    if [[ -d "$PROJECT_DIR" && -n "$(ls -A "$PROJECT_DIR" 2>/dev/null)" ]]; then
      die "Directory '$PROJECT_NAME' already exists and is not empty."
    fi
  fi
}

