  build_cmd=$(runtime_build_command)
  install_cmd=$(runtime_install_command)
  vite_cmd=$(runtime_vite_command)

  cat > "$PROJECT_DIR/README.md" <<EOF
# $PROJECT_NAME

Saucer desktop WebView application with a Vite frontend.

Created by $AUTHOR_NAME <$AUTHOR_EMAIL>

## Frontend initialization

The setup intentionally does not choose a Vite framework for you. Create the
Vite project inside \`frontend/\` with $FRONTEND_RUNTIME:

\`\`\`bash
cd frontend
$vite_cmd
$install_cmd
\`\`\`

The \`frontend/tools/dev.mjs\` file is generated by c-setup. Because \`frontend/\`
is already non-empty, create-vite may warn about the existing \`tools/\` folder.
Choose the option that keeps/ignores existing files rather than deleting them.

The production frontend command used by this project is:

\`\`\`bash
$build_cmd
\`\`\`
EOF

  if [[ "$SAUCER_BUILD_SYSTEM" == "zig-cmake" ]]; then
    cat >> "$PROJECT_DIR/README.md" <<'EOF'

## Build commands

```bash
zig build
zig build dev
zig build run
zig build release
zig build release-run
zig build release-clean
zig build clean
zig build clean-all
```
EOF
  else
    cat >> "$PROJECT_DIR/README.md" <<EOF

## CMake + Ninja

Development native build:

\`\`\`bash
