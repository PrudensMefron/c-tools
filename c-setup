# PIPELINES

pipeline_traditional_full() {
  ask_language
  ask_build_system
  ask_git
  ask_format
  ask_standards
  ask_author

  create_traditional_structure
  $USE_MESON && create_meson
  $USE_MAKE && create_makefile
  $USE_CMAKE && create_cmake
  $USE_ZIG && create_traditional_zig
  $USE_CLANG_FORMAT && create_clang_format
  $USE_ZED_SETTINGS && create_zed_settings
  $USE_CLANG_TIDY && create_clang_tidy
  create_main
  git_init
}

pipeline_saucer_full() {
  ask_saucer_build_system
  ask_frontend_runtime
  ask_git
  ask_format
  ask_author

  create_saucer_structure
  create_saucer_main
  create_saucer_dev_script

  if [[ "$SAUCER_BUILD_SYSTEM" == "cmake" ]]; then
    create_saucer_cmake_native
  else
    create_saucer_cmake_zig
  fi

  $USE_CLANG_FORMAT && create_clang_format
  $USE_ZED_SETTINGS && create_zed_settings
  $USE_CLANG_TIDY && create_clang_tidy

  create_saucer_readme
  git_init
  print_saucer_next_steps
}

pipeline_full() {
  ask_project_kind

  if [[ "$PROJECT_KIND" == "saucer" ]]; then
    pipeline_saucer_full
  else
    pipeline_traditional_full
  fi
}

pipeline_build() {
  ask_language
  ask_build_system
  mkdir -p "$PROJECT_DIR"/{src,include}
  $USE_MESON && create_meson
  $USE_MAKE && create_makefile
  $USE_CMAKE && create_cmake
  $USE_ZIG && create_traditional_zig
}

pipeline_format() {
  ask_language
  ask_format
  mkdir -p "$PROJECT_DIR"
  $USE_CLANG_FORMAT && create_clang_format
  $USE_ZED_SETTINGS && create_zed_settings
  $USE_CLANG_TIDY && create_clang_tidy
}

pipeline_lang() {
  ask_language
  mkdir -p "$PROJECT_DIR/src"
  create_main
}

# ----------------------------------------------------
# MAIN

main() {
  parse_args "$@"

  echo -e "${GREEN}=== Allman++ C/C++ Project Setup ===${NC}\n"

  if $FLAG_FULL_SETUP; then
    pipeline_full
  else
    if $FLAG_BUILD_ONLY; then pipeline_build; fi
    if $FLAG_LANG_ONLY; then pipeline_lang; fi
    if $FLAG_GIT_ONLY; then USE_GIT=true; git_init; fi
    if $FLAG_FORMAT_ONLY; then pipeline_format; fi
  fi

  info "Project operation completed successfully."
  echo "Location: $PROJECT_DIR"
}

main "$@"
