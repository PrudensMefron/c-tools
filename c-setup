# ENVIRONMENT VALIDATION

validate_traditional_build_environment() {
  case "$BUILD_SYSTEM" in
    meson)
      require_command meson
      require_command ninja
      ;;
    cmake)
      require_command cmake
      require_command ninja
      validate_cmake_version "$(cmake_minimum_version)"
      ;;
    xmake)
      require_command xmake
      validate_xmake_version
      ;;
    zig)
      require_command zig
      validate_zig_version
      ;;
    make)
      require_command make
      ;;
    none)
      ;;
  esac
}

validate_saucer_environment() {
  require_command cmake
  require_command ninja

  if [[ "$SAUCER_BUILD_SYSTEM" == "zig-cmake" ]]; then
    validate_cmake_version "3.31"
    require_command zig
    validate_zig_version
  else
    validate_cmake_version "3.25"
  fi

  require_command "$FRONTEND_RUNTIME"

  if [[ "$FRONTEND_RUNTIME" != "bun" ]]; then
    require_command node
  fi
}

validate_environment() {
  $DRY_RUN && return 0

  case "$MODE" in
    full)
      if [[ "$PROJECT_KIND" == "saucer" ]]; then
        validate_saucer_environment
      else
        validate_traditional_build_environment
      fi

      $USE_GIT && require_command git
      ;;

    build)
      validate_traditional_build_environment
      ;;

    git)
      require_command git
      ;;
  esac

  return 0
}

