MAKEFILE_BASE='CC := {CC}
CXX := {CXX}
CFLAGS := -Wall -Wextra -Wpedantic {C_STD} -Iinclude
CXXFLAGS := -Wall -Wextra -Wpedantic {CPP_STD} -Iinclude
LDFLAGS :=
SRC := src
OBJ := obj
BIN := bin
TARGET := {PROJECT_NAME}

SOURCES := $(wildcard $(SRC)/*.c) $(wildcard $(SRC)/*.cpp)
OBJECTS := $(patsubst $(SRC)/%.c,$(OBJ)/%.o,$(patsubst $(SRC)/%.cpp,$(OBJ)/%.o,$(SOURCES)))

.PHONY: all clean run

all: $(BIN)/$(TARGET)

$(BIN)/$(TARGET): $(OBJECTS) | $(BIN)
	$(CXX) $(LDFLAGS) -o $@ $^

$(OBJ)/%.o: $(SRC)/%.c | $(OBJ)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ)/%.o: $(SRC)/%.cpp | $(OBJ)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BIN) $(OBJ):
	mkdir -p $@

clean:
	rm -rf $(OBJ) $(BIN)

run: all
	./$(BIN)/$(TARGET)
'

