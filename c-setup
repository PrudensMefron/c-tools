# ----------------------------------------------------
# AUXILIARY FUNCTIONS

die() { echo -e "${RED}Error: $*${NC}" >&2; exit 1; }
info() { echo -e "${GREEN}Success: $*${NC}"; }
warn() { echo -e "${YELLOW}Warn: $*${NC}"; }
note() { echo -e "${CYAN}$*${NC}"; }

validate_project_name() {
  [[ "$PROJECT_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
    die "Project name must use only letters, numbers, '.', '_' or '-', and must start with a letter or number."
}

get_author_info() {
  local git_name git_email

  git_name=$(git config --local --get user.name 2>/dev/null || true)
  git_email=$(git config --local --get user.email 2>/dev/null || true)

  [[ -z "$git_name" ]] && git_name=$(git config --global --get user.name 2>/dev/null || true)
  [[ -z "$git_email" ]] && git_email=$(git config --global --get user.email 2>/dev/null || true)

  AUTHOR_NAME="${git_name:-}"
  AUTHOR_EMAIL="${git_email:-}"
}

runtime_build_command() {
  case "$FRONTEND_RUNTIME" in
    bun) echo "bun run build" ;;
    pnpm) echo "pnpm run build" ;;
    npm) echo "npm run build" ;;
    yarn) echo "yarn run build" ;;
    *) die "Unknown frontend runtime: $FRONTEND_RUNTIME" ;;
  esac
}

runtime_install_command() {
  case "$FRONTEND_RUNTIME" in
    bun) echo "bun install" ;;
    pnpm) echo "pnpm install" ;;
    npm) echo "npm install" ;;
    yarn) echo "yarn install" ;;
    *) die "Unknown frontend runtime: $FRONTEND_RUNTIME" ;;
  esac
}

runtime_vite_command() {
  case "$FRONTEND_RUNTIME" in
    bun) echo "bun create vite ." ;;
    pnpm) echo "pnpm create vite ." ;;
    npm) echo "npm create vite@latest ." ;;
    yarn) echo "yarn create vite ." ;;
    *) die "Unknown frontend runtime: $FRONTEND_RUNTIME" ;;
  esac
}

# ----------------------------------------------------
# INTERACTIVE QUESTIONS

ask_project_kind() {
  [[ -n "$PROJECT_KIND" ]] && return

  echo -e "\nChoose project type:"
  select opt in "Traditional C/C++" "Desktop WebView with Saucer"; do
    case $REPLY in
      1) PROJECT_KIND="traditional"; break ;;
      2) PROJECT_KIND="saucer"; LANG_CHOICE="cpp"; CPP_STANDARD="c++23"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_language() {
  [[ -n "$LANG_CHOICE" ]] && return

  echo -e "\nChoose language:"
  select opt in "C" "C++" "Both (C & C++)"; do
    case $REPLY in
      1) LANG_CHOICE="c"; break ;;
      2) LANG_CHOICE="cpp"; break ;;
      3) LANG_CHOICE="both"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_build_system() {
  echo -e "\nChoose a build system:"
  select build in "Meson + Ninja (default)" "CMake + Ninja" "Zig" "Makefile" "All" "None"; do
    case $REPLY in
      1) USE_MESON=true; break ;;
      2) USE_CMAKE=true; break ;;
      3) USE_ZIG=true; break ;;
      4) USE_MAKE=true; break ;;
      5) USE_MESON=true; USE_CMAKE=true; USE_ZIG=true; USE_MAKE=true; break ;;
      6) break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_saucer_build_system() {
  echo -e "\nChoose the Saucer build system:"
  select build in "CMake + Ninja" "Zig + CMake + Ninja"; do
    case $REPLY in
      1) SAUCER_BUILD_SYSTEM="cmake"; break ;;
      2) SAUCER_BUILD_SYSTEM="zig-cmake"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_frontend_runtime() {
  echo -e "\nChoose the frontend package manager/runtime:"
  select runtime in "Bun" "Pnpm" "Npm" "Yarn"; do
    case $REPLY in
      1) FRONTEND_RUNTIME="bun"; break ;;
      2) FRONTEND_RUNTIME="pnpm"; break ;;
      3) FRONTEND_RUNTIME="npm"; break ;;
      4) FRONTEND_RUNTIME="yarn"; break ;;
      *) warn "Invalid option." ;;
    esac
  done
}

ask_git() {
  read -rp $'\nInitialize a blank Git repository? [Y/N] ' ans
  if [[ "$ans" =~ ^([yY]|$) ]]; then
    USE_GIT=true
  fi
}

ask_format() {
  read -rp $'\nAdd Allman++ .clang-format? [Y/N] ' ans
  if [[ "$ans" =~ ^([yY]|$) ]]; then
    USE_CLANG_FORMAT=true
    USE_ZED_SETTINGS=true
  fi

  read -rp $'\nAdd .clang-tidy? [Y/N] ' ans
  if [[ "$ans" =~ ^([yY]|$) ]]; then
    USE_CLANG_TIDY=true
  fi
}

ask_standards() {
  if [[ "$LANG_CHOICE" == "c" || "$LANG_CHOICE" == "both" ]]; then
    echo -e "\nSelect C standard:"
    select std in "c89" "c99" "c11" "c17" "c23"; do
      case $REPLY in
        1|2|3|4|5) C_STANDARD="$std"; break ;;
        *) warn "Invalid option." ;;
      esac
    done
  fi

  if [[ "$LANG_CHOICE" == "cpp" || "$LANG_CHOICE" == "both" ]]; then
    echo -e "\nSelect C++ standard:"
    select std in "c++11" "c++14" "c++17" "c++20" "c++23"; do
      case $REPLY in
        1|2|3|4|5) CPP_STANDARD="$std"; break ;;
        *) warn "Invalid option." ;;
      esac
    done
  fi
}

ask_author() {
  get_author_info

  if [[ -n "$AUTHOR_NAME" ]]; then
    info "Author detected: $AUTHOR_NAME <$AUTHOR_EMAIL>"
    read -rp $'Use this author info? [Y/N] ' ans
    if [[ ! "$ans" =~ ^([yY]|$) ]]; then
      read -rp $'New author name: ' AUTHOR_NAME
      read -rp $'New author email: ' AUTHOR_EMAIL
    fi
  else
    warn "Author info not detected."
    read -rp $'Your name: ' AUTHOR_NAME
    read -rp $'Your email: ' AUTHOR_EMAIL
  fi
}

# ----------------------------------------------------
# CLI

usage() {
  cat <<'EOF'
Usage: c-setup [options] [project_name]

Options:
  -b, --build   Setup only a traditional build system
  -l, --lang    Setup only the language and main source file
  -g, --git     Initialize a Git repository only
  -f, --format  Setup Allman++ clang-format, Zed settings and clang-tidy only
  -h, --help    Show this help message

Without options, c-setup runs the full interactive setup. The full setup can
create either a traditional C/C++ project or a Saucer desktop WebView project.
EOF
  exit 0
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--build) FLAG_BUILD_ONLY=true; FLAG_FULL_SETUP=false; shift ;;
      -l|--lang)
        FLAG_LANG_ONLY=true
        FLAG_FULL_SETUP=false
        if [[ -n "${2:-}" && ! "$2" =~ ^- ]]; then
          LANG_CHOICE="$2"
          shift 2
        else
          shift
        fi
        ;;
      -g|--git) FLAG_GIT_ONLY=true; FLAG_FULL_SETUP=false; shift ;;
      -f|--format) FLAG_FORMAT_ONLY=true; FLAG_FULL_SETUP=false; shift ;;
      -h|--help) usage ;;
      -*) die "Unknown option: $1. Use -h for help." ;;
      *)
        if [[ -z "$PROJECT_NAME" ]]; then
          PROJECT_NAME="$1"
          shift
        else
          die "Multiple project names provided: $PROJECT_NAME and $1"
        fi
        ;;
    esac
  done

  if [[ -z "$PROJECT_NAME" ]]; then
    if $FLAG_FULL_SETUP; then
      read -rp "Project name: " PROJECT_NAME
      [[ -z "$PROJECT_NAME" ]] && die "Project name is required."
    else
      PROJECT_NAME=$(basename "$(pwd)")
    fi
  fi

  validate_project_name

  if [[ "$PROJECT_NAME" == "$(basename "$(pwd)")" ]]; then
    PROJECT_DIR="$(pwd)"
  else
    PROJECT_DIR="$(pwd)/$PROJECT_NAME"
    if [[ -d "$PROJECT_DIR" && -n "$(ls -A "$PROJECT_DIR" 2>/dev/null)" ]]; then
      die "Directory '$PROJECT_NAME' already exists and is not empty."
    fi
  fi
}

