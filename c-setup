create_makefile() {
  info "Generating Makefile"

  local content="$MAKEFILE_BASE"
  local sources
  local linker

  case "$LANG_CHOICE" in
    c)
      sources='$(wildcard $(SRC)/*.c)'
      linker='$(CC)'
      ;;
    cpp)
      sources='$(wildcard $(SRC)/*.cpp)'
      linker='$(CXX)'
      ;;
    both)
      sources='$(wildcard $(SRC)/*.c) $(wildcard $(SRC)/*.cpp)'
      linker='$(CXX)'
      ;;
  esac

  content="${content//\{PROJECT_NAME\}/$PROJECT_NAME}"
  content="${content//\{C_STD\}/-std=$C_STANDARD}"
  content="${content//\{CPP_STD\}/-std=$CPP_STANDARD}"
  content="${content//\{SOURCES\}/$sources}"
  content="${content//\{LINKER\}/$linker}"

  printf '%s\n' "$content" > "$PROJECT_DIR/Makefile"
}

create_cmake() {
  info "Generating CMakeLists.txt"

  local lang_list="C"
  local std_config
  local content="$CMAKE_BASE"
  local cmake_min
  local c_std_value

  cmake_min="$(cmake_minimum_version)"
  c_std_value="$(cmake_c_standard_value)"

  [[ "$LANG_CHOICE" == "cpp" ]] && lang_list="CXX"
  [[ "$LANG_CHOICE" == "both" ]] && lang_list="C CXX"

  std_config="set(CMAKE_C_STANDARD $c_std_value)\nset(CMAKE_C_STANDARD_REQUIRED ON)\nset(CMAKE_C_EXTENSIONS OFF)"

  if [[ "$LANG_CHOICE" == "cpp" ]]; then
    std_config="set(CMAKE_CXX_STANDARD ${CPP_STANDARD#c++})\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\nset(CMAKE_CXX_EXTENSIONS OFF)"
  elif [[ "$LANG_CHOICE" == "both" ]]; then
    std_config="set(CMAKE_C_STANDARD $c_std_value)\nset(CMAKE_C_STANDARD_REQUIRED ON)\nset(CMAKE_C_EXTENSIONS OFF)\nset(CMAKE_CXX_STANDARD ${CPP_STANDARD#c++})\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\nset(CMAKE_CXX_EXTENSIONS OFF)"
  fi

  content="${content//\{PROJECT_NAME\}/$PROJECT_NAME}"
  content="${content//\{LANG_LIST\}/$lang_list}"
  content="${content//\{STD_CONFIG\}/$std_config}"
  content="${content//\{CMAKE_MIN\}/$cmake_min}"

  printf '%b\n' "$content" > "$PROJECT_DIR/CMakeLists.txt"
}

create_meson() {
  info "Generating Meson build files"

  local lang_list="'c'"
  local std_opts="'c_std=$C_STANDARD'"
  local sources="'main.c'"
  local root_content
  local src_content

  if [[ "$LANG_CHOICE" == "cpp" ]]; then
    lang_list="'cpp'"
    std_opts="'cpp_std=$CPP_STANDARD'"
    sources="'main.cpp'"
  elif [[ "$LANG_CHOICE" == "both" ]]; then
    lang_list="'c', 'cpp'"
    std_opts="'c_std=$C_STANDARD', 'cpp_std=$CPP_STANDARD'"
    sources="'main.cpp'"
  fi

  root_content="$MESON_ROOT_BASE"
  root_content="${root_content//\{PROJECT_NAME\}/$PROJECT_NAME}"
  root_content="${root_content//\{LANG_LIST\}/$lang_list}"
  root_content="${root_content//\{STD_OPTIONS\}/$std_opts}"

  printf '%s\n' "$root_content" > "$PROJECT_DIR/meson.build"

  src_content="$MESON_SRC_BASE"
  src_content="${src_content//\{PROJECT_NAME\}/$PROJECT_NAME}"
  src_content="${src_content//\{SOURCES\}/$sources}"

  printf '%s\n' "$src_content" > "$PROJECT_DIR/src/meson.build"
}

create_xmake() {
  info "Generating xmake.lua"

  local languages
  local sources
  local content="$XMAKE_BASE"

  case "$LANG_CHOICE" in
    c)
      languages="\"$C_STANDARD\""
      sources="\"src/**.c\""
      ;;
    cpp)
      languages="\"$CPP_STANDARD\""
      sources="\"src/**.cpp\""
      ;;
    both)
      languages="\"$C_STANDARD\", \"$CPP_STANDARD\""
      sources="\"src/**.c\", \"src/**.cpp\""
      ;;
  esac

  content="${content//\{PROJECT_NAME\}/$PROJECT_NAME}"
  content="${content//\{LANGUAGES\}/$languages}"
  content="${content//\{SOURCES\}/$sources}"

  printf '%s\n' "$content" > "$PROJECT_DIR/xmake.lua"
}

create_clang_format() {
  info "Generating .clang-format with Allman++ style"
  printf '%s\n' "$CLANG_FORMAT_ALLMAN_PP" > "$PROJECT_DIR/.clang-format"
}

create_zed_settings() {
  info "Generating Zed project settings for Allman++"
  mkdir -p "$PROJECT_DIR/.zed"
  printf '%s\n' "$ZED_SETTINGS_ALLMAN_PP" > "$PROJECT_DIR/.zed/settings.json"
}

create_clang_tidy() {
  info "Generating .clang-tidy"
  printf '%s\n' "$CLANG_TIDY_BASE" > "$PROJECT_DIR/.clang-tidy"
}

create_main() {
  info "Generating source files"

  if [[ "$LANG_CHOICE" == "c" ]]; then
    local content="${MAIN_C//\{PROJECT_NAME\}/$PROJECT_NAME}"
    printf '%s\n' "$content" > "$PROJECT_DIR/src/main.c"
  else
    local content="${MAIN_CPP//\{PROJECT_NAME\}/$PROJECT_NAME}"
    printf '%s\n' "$content" > "$PROJECT_DIR/src/main.cpp"
  fi
}

create_traditional_zig() {
  info "Generating Zig 0.16 build system"

  local source_file
  local cpp_enabled
  local flags

  if [[ "$LANG_CHOICE" == "c" ]]; then
    source_file="src/main.c"
    cpp_enabled="false"
    flags="\"-Wall\", \"-Wextra\", \"-Wpedantic\", \"-std=$C_STANDARD\""
  else
    source_file="src/main.cpp"
    cpp_enabled="true"
    flags="\"-Wall\", \"-Wextra\", \"-Wpedantic\", \"-std=$CPP_STANDARD\""
  fi

  cat > "$PROJECT_DIR/build.zig" <<EOF
const std = @import("std");

const project_name = "$PROJECT_NAME";

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});

    const debug_exe = createExecutable(b, target, .Debug);
    const debug_install = b.addInstallArtifact(debug_exe, .{
        .dest_dir = .{ .override = .{ .custom = "debug/bin" } },
    });

    b.getInstallStep().dependOn(&debug_install.step);

    const build_step = b.step("build", "Build the debug application");
    build_step.dependOn(&debug_install.step);

    const run = b.addRunArtifact(debug_exe);
    if (b.args) |args| run.addArgs(args);

    const run_step = b.step("run", "Build and run the debug application");
    run_step.dependOn(&run.step);

    const release_exe = createExecutable(b, target, .ReleaseFast);
    const release_install = b.addInstallArtifact(release_exe, .{
        .dest_dir = .{ .override = .{ .custom = "release/bin" } },
    });

    const release_step = b.step("release", "Build the optimized release application");
    release_step.dependOn(&release_install.step);

    const release_run = b.addRunArtifact(release_exe);
    if (b.args) |args| release_run.addArgs(args);

    const release_run_step = b.step("release-run", "Build and run the release application");
    release_run_step.dependOn(&release_run.step);

    const release_clean = b.addSystemCommand(&.{ "rm", "-rf", "zig-out/release" });
    const release_clean_step = b.step("release-clean", "Remove installed release artifacts");
    release_clean_step.dependOn(&release_clean.step);

    const clean = b.addSystemCommand(&.{ "rm", "-rf", "zig-out" });
    const clean_step = b.step("clean", "Remove installed build artifacts");
    clean_step.dependOn(&clean.step);
}

fn createExecutable(
    b: *std.Build,
    target: std.Build.ResolvedTarget,
    optimize: std.builtin.OptimizeMode,
) *std.Build.Step.Compile {
    const module = b.createModule(.{
        .root_source_file = null,
        .target = target,
        .optimize = optimize,
        .link_libc = true,
        .link_libcpp = $cpp_enabled,
    });

    module.addIncludePath(b.path("include"));
    module.addCSourceFiles(.{
        .root = b.path("."),
        .files = &.{ "$source_file" },
        .flags = &.{ $flags },
    });

    return b.addExecutable(.{
        .name = project_name,
        .root_module = module,
    });
}
EOF
}

create_build_system() {
  case "$BUILD_SYSTEM" in
    meson) create_meson ;;
    cmake) create_cmake ;;
    xmake) create_xmake ;;
    zig) create_traditional_zig ;;
    make) create_makefile ;;
    none) ;;
    *) die "Unknown build system: $BUILD_SYSTEM" ;;
  esac
}

